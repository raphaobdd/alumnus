# Variáveis de ambiente — Sistema de Organização Acadêmica
# Copie este arquivo para .env.local e preencha com seus valores
# NUNCA commite .env.local no Git

# ============================================================
# SUPABASE — Configurações do projeto
# Encontre em: Supabase Dashboard → Settings → API
# ============================================================

# URL do projeto (seguro para expor ao client)
NEXT_PUBLIC_SUPABASE_URL=https://SEU_PROJETO.supabase.co

# URL pública da aplicação (para redirecionamentos de auth e e-mails)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Chave anônima / pública (segura para o client — respeita RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ============================================================
# SUPABASE SERVICE ROLE — APENAS SERVER-SIDE
# ⚠️ NUNCA adicione NEXT_PUBLIC_ nesta variável
# ⚠️ Esta chave bypassa o RLS — use SOMENTE em Server Actions/Route Handlers
# ============================================================
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
